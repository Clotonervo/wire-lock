{
  "name": "@wire-lock/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:lag": "tsx watch src/index.ts --latency=150",
    "build": "tsc -p tsconfig.json && tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.17",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.4",
    "@wire-lock/shared": "workspace:*"
  }
}
